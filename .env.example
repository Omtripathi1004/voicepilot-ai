# VoicePilot AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Rime TTS Configuration (organizer-provided) ─────────────────────────────
# Required for actual Rime TTS synthesis. Leave empty to use mock TTS for dev.
RIME_API_KEY=
RIME_MODEL_ID=mist
RIME_VOICE=luna
RIME_LANGUAGE=eng
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts
RIME_AUDIO_FORMAT=mp3
RIME_REGION=

# ─── Public Rime Catalog URLs (NO API KEY REQUIRED) ──────────────────────────
# These are keyless public endpoints used only for voice/model discovery.
# Do NOT add API key variables for these URLs.
RIME_VOICE_CATALOG_URL=https://users.rime.ai/data/voices/all-v2.json
RIME_VOICE_DETAILS_URL=https://users.rime.ai/data/voices/voice_details.json

# ─── Backend Configuration ───────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-use-long-random-string

# ─── STT Configuration ───────────────────────────────────────────────────────
# STT provider: 'browser' (Web Speech API via frontend) or 'whisper' (local)
STT_PROVIDER=browser
# Optional: Path to local Whisper model if using local STT
# WHISPER_MODEL_SIZE=base

# ─── LLM / Agent Configuration ───────────────────────────────────────────────
# LLM provider: 'local' (rule-based, no key) or 'openai' (requires key) or 'anthropic'
LLM_PROVIDER=local
# Optional: Only needed if LLM_PROVIDER=openai
# OPENAI_API_KEY=
# Optional: Only needed if LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# ─── Benchmark Configuration (optional) ──────────────────────────────────────
# Optional alternative TTS providers for benchmark comparison only.
# Not required for demo or acceptance test.
# ALT_TTS_PROVIDER_1=
# ALT_TTS_KEY_1=
# ALT_TTS_PROVIDER_2=
# ALT_TTS_KEY_2=

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
MAX_WEBSOCKET_CONNECTIONS=20

# ─── Audio Configuration ─────────────────────────────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=1024
TTS_CACHE_ENABLED=true
TTS_CACHE_TTL_SECONDS=3600

# ─── Voice Catalog Cache ─────────────────────────────────────────────────────
VOICE_CATALOG_CACHE_TTL_SECONDS=3600
